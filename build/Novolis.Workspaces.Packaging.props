<Project>
  <PropertyGroup Label="Novolis.Workspaces NuGet metadata">
    <Authors>Novolis</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Novolis-Platform/novolis-workspaces</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>workspace;snapshot;timeline;save;editor;studio</PackageTags>
  </PropertyGroup>
</Project>
