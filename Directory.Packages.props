<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Roslyn's net10.0 MSBuild workspace host requires the framework asset. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <!-- MSBuild 18.11's locator validation requires this build-only asset to be private. -->
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Novolis.IO.Workspace.Abstractions" Version="2026.1.*" />
    <PackageVersion Include="Novolis.IO.Git" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Avalonia.Rendering" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Audio.Core" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Audio.Playback" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Audio.Output.NAudio" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.Backends.Cpu" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.Compile" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.DependencyInjection" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.Materials" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.PathTrace.Demos" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Silk" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.Runtime" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Rendering.Scene" Version="2026.1.*" />
    <PackageVersion Include="Novolis.Simulation.View" Version="2026.1.*" />
  </ItemGroup>
</Project>

